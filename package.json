{
  "name": "llm-lens",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @llm-lens/e2e test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky",
    "demo:api": "DEMO_MODE=true DATABASE_URL=file:./demo.db JWT_SECRET=demo-local-secret PORT=3032 AUTH_RATE_LIMIT_MAX=1000 pnpm --filter @llm-lens/api dev",
    "demo:web": "NUXT_PUBLIC_API_BASE=http://localhost:3032/api NUXT_PUBLIC_DEMO_MODE=true NUXT_IGNORE_LOCK=1 pnpm --filter @llm-lens/web exec nuxt dev --port 3031",
    "demo": "concurrently -n api,web -c blue,green --kill-others-on-fail \"pnpm demo:api\" \"pnpm demo:web\""
  },
  "lint-staged": {
    "apps/web/**/*.{ts,vue}": "apps/web/node_modules/.bin/eslint --fix --no-warn-ignored",
    "apps/api/src/**/*.ts": "apps/api/node_modules/.bin/eslint --fix --no-warn-ignored"
  },
  "devDependencies": {
    "concurrently": "9.2.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
