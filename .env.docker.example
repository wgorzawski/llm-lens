# Copy to .env for docker compose. Only JWT_SECRET is required.
JWT_SECRET=

# Public URLs (what the browser uses). Behind a reverse proxy, set your domains here.
PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# false = invite-only after the first (owner) account
REGISTRATION_ENABLED=true
# 0 = keep traces forever
DEFAULT_RETENTION_DAYS=0
BACKUP_KEEP_DAYS=14

# Optional: e-mail for alerts and digests
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  SMTP_FROM=
# Optional: keys used by "Replay" (OPENAI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY, ...)
