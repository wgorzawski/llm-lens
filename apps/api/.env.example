# ── Required ────────────────────────────────────────────────────────────────────

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────────

# Path to the SQLite database file. Created automatically on first run.
# Default: ./llm-lens.db  (relative to apps/api)
DATABASE_URL=file:./llm-lens.db

# ── Server URLs ──────────────────────────────────────────────────────────────────

# Public URL of this API server (used to build OAuth callback URLs)
API_URL=http://localhost:3001

# Public URL of the frontend (used for post-OAuth redirects)
FRONTEND_URL=http://localhost:3000

# ── OAuth — Google (optional) ────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${API_URL}/api/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub (optional) ────────────────────────────────────────────────────
# Create credentials at: https://github.com/settings/developers
# Authorization callback URL: ${API_URL}/api/auth/github/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Trace replay (optional) ──────────────────────────────────────────────────────
# Required only if you use the "Replay" feature on trace detail pages.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Self-hosted / production instance (optional) ───────────────────────────────

# false closes sign-ups (e-mail and OAuth). The first account on a fresh install and
# people with a pending invite can still register. Set NUXT_PUBLIC_REGISTRATION_ENABLED=false
# on the web app too, to hide the sign-up links.
REGISTRATION_ENABLED=true

# Retention for new organizations, in days. 0 keeps traces forever. Default: 7
DEFAULT_RETENTION_DAYS=7

# Max request body in MB (long prompts can exceed Fastify's 1 MB default). Default: 10
BODY_LIMIT_MB=10

# Daily SQLite snapshot (VACUUM INTO) into this directory; disabled when empty.
BACKUP_DIR=
# How many daily snapshots to keep. Default: 14
BACKUP_KEEP_DAYS=14

# Comma-separated origins allowed to call the API from a browser (the web app's URL).
# Empty = any origin. Example: https://llmlens.example.com
CORS_ORIGINS=

# How long a sign-in stays valid (sessions can also be revoked in Settings). Default: 30d
JWT_TTL=30d

# JSON file with prices for models the built-in list doesn't know, USD per 1M tokens:
# { "my-finetune": { "in": 1.5, "out": 6 }, "together:meta-llama/Llama-3.3-70B-Instruct-Turbo": { "in": 0.88, "out": 0.88 } }
PRICING_FILE=

# ── E-mail (sign-in alerts, threshold alerts, daily / weekly digests) ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LLM Lens <noreply@example.com>"

# ── Replay for other OpenAI-compatible providers (optional) ─────────────────────
# GEMINI_API_KEY= MISTRAL_API_KEY= DEEPSEEK_API_KEY= XAI_API_KEY= OPENROUTER_API_KEY=
# TOGETHER_API_KEY= FIREWORKS_API_KEY= PERPLEXITY_API_KEY= CEREBRAS_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AZURE_OPENAI_API_KEY= AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>?api-version=2024-10-21
